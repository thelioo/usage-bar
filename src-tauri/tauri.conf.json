{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Usage Bar",
  "version": "0.1.0",
  "identifier": "dev.thelio.usagebar",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Usage Bar",
        "url": "index.html",
        "width": 600,
        "height": 700,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "focus": false
      },
      {
        "label": "dock",
        "title": "Usage Bar",
        "url": "index.html",
        "width": 160,
        "height": 48,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "focus": false
      },
      {
        "label": "overlay",
        "title": "Usage Bar",
        "url": "overlay.html",
        "width": 800,
        "height": 600,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "focus": false
      },
      {
        "label": "panel",
        "title": "Usage Bar",
        "url": "index.html",
        "width": 380,
        "height": 320,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true
      },
      {
        "label": "settings",
        "title": "Usage Bar",
        "url": "settings.html",
        "width": 540,
        "height": 640,
        "visible": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}